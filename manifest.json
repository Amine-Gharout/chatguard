{
  "manifest_version": 3,
  "name": "ChatGuard — Send Nudge (CDH Demo)",
  "version": "0.1.0",
  "description": "Research prototype: nudges you before sending sensitive/emotional messages (romantic, distress, self-harm, violence, explicit content, private info, and more) to ChatGPT, Claude, or Gemini. Runs fully locally.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ChatGuard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatguard@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/shared/settings.js",
        "src/shared/storage.js",
        "src/shared/detector.js",
        "src/content/dom.js",
        "src/content/files.js",
        "src/content/modal.js",
        "src/content/content.js"
      ]
    }
  ]
}
